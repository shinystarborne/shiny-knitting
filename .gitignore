# Build output and dependencies. All reproducible from source.
node_modules/
dist/
dist-harness/
src-tauri/target/
src-tauri/gen/

# Generated by the make-*.py scripts at the repository root, then copied into
# public/fixtures/ for the test harness. Regenerate rather than commit: they are
# binaries that would dominate the history and mean nothing in a diff.
#
# Anchored with a leading slash on purpose. An unanchored "fixtures/" would also
# match public/fixtures/ and src-tauri/tests/fixtures/, and git cannot re-include
# a file whose parent directory is excluded -- which would silently drop
# sample.jpg and make the export tests panic on a fresh clone.
/fixtures/

# Local secrets. The model API key is never stored here -- it goes through
# Windows DPAPI into the app's own database -- but an .env is the obvious place
# to reach for one, so it is ignored rather than trusted.
.env
.env.*
!.env.example

# The app's own library lives in %APPDATA%, but a stray database in the working
# tree is someone's patterns and should not be committed.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Editors and operating systems.
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

*.log
